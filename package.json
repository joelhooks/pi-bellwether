{
  "name": "@joelhooks/pi-bellwether",
  "version": "1.0.0",
  "description": "Bellwether 🐏🔔 — Effect-powered direct Herdr socket control and XState watch lifecycles for Pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "bellwether",
    "terminal",
    "agents",
    "effect",
    "xstate"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joelhooks/pi-bellwether"
  },
  "homepage": "https://github.com/joelhooks/pi-bellwether#readme",
  "bugs": {
    "url": "https://github.com/joelhooks/pi-bellwether/issues"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions/pi-bellwether.ts",
    "src/herdr-client.ts",
    "src/intercom.ts",
    "src/ping-wait.ts",
    "src/watch.ts",
    "skills/pi-bellwether/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --project tsconfig.json",
    "smoke": "bash -lc 'PI_OFFLINE=1 pi -e . --help >/tmp/pi-bellwether-help.out 2>/tmp/pi-bellwether-help.err; status=$?; rg -n \"pi-bellwether|herdr_|cannot load|Error loading\" /tmp/pi-bellwether-help.out /tmp/pi-bellwether-help.err || true; exit $status'",
    "test": "bun test src extensions",
    "pack:check": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/bun": "^1.3.14",
    "@types/node": "latest",
    "typebox": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "effect": "4.0.0-beta.99",
    "xstate": "5.32.5"
  }
}
